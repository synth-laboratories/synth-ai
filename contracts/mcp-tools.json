{
  "tools": [
    {
      "description": "The caller's org, principal and limits.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "account_get",
      "operationId": "getAccount",
      "scope": "account:read"
    },
    {
      "description": "The caller's runs, newest first.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "created_after": {
            "format": "date-time",
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "project_id": {
            "examples": [
              "proj_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^proj_[A-Za-z0-9_-]{22}$",
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "swarms_runs_list",
      "operationId": "listRuns",
      "scope": "swarms:read"
    },
    {
      "description": "Launch a run.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "properties": {
              "inputs": {
                "properties": {
                  "files": {
                    "items": {
                      "properties": {
                        "digest_sha256": {
                          "pattern": "^[0-9a-f]{64}$",
                          "type": "string"
                        },
                        "file_id": {
                          "type": "string"
                        },
                        "project_id": {
                          "examples": [
                            "proj_AAAAAAAAAAAAAAAAAAAAAA"
                          ],
                          "pattern": "^proj_[A-Za-z0-9_-]{22}$",
                          "type": "string"
                        },
                        "revision_id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "file_id",
                        "revision_id",
                        "project_id",
                        "digest_sha256"
                      ],
                      "type": "object"
                    },
                    "maxItems": 32,
                    "type": "array"
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "labels": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "limits": {
                "description": "maximum_charge is required; explicit null requests operator-funded local execution. maximum_parallel_tasks cannot exceed maximum_tasks.",
                "properties": {
                  "maximum_charge": {
                    "oneOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "amount": {
                            "examples": [
                              "5.00"
                            ],
                            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$",
                            "type": "string"
                          },
                          "currency": {
                            "const": "USD",
                            "type": "string"
                          }
                        },
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "maximum_parallel_tasks": {
                    "maximum": 1000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "maximum_tasks": {
                    "maximum": 1000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "wall_time_seconds": {
                    "maximum": 86400,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "maximum_charge",
                  "wall_time_seconds",
                  "maximum_tasks",
                  "maximum_parallel_tasks"
                ],
                "type": "object"
              },
              "message": {
                "maxLength": 8192,
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "method": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "models": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "profile_overrides": {
                "additionalProperties": false,
                "properties": {
                  "launch": {
                    "additionalProperties": false,
                    "properties": {
                      "canonical_model": {
                        "type": "string"
                      },
                      "effort": {
                        "enum": [
                          "low",
                          "medium",
                          "high",
                          "xhigh"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [],
                    "type": "object"
                  },
                  "roles": {
                    "additionalProperties": {
                      "additionalProperties": false,
                      "properties": {
                        "canonical_model": {
                          "type": "string"
                        },
                        "effort": {
                          "enum": [
                            "low",
                            "medium",
                            "high",
                            "xhigh"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [],
                      "type": "object"
                    },
                    "type": "object"
                  }
                },
                "required": [],
                "type": "object"
              },
              "program": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "type": "object"
              },
              "project_id": {
                "examples": [
                  "proj_AAAAAAAAAAAAAAAAAAAAAA"
                ],
                "pattern": "^proj_[A-Za-z0-9_-]{22}$",
                "type": "string"
              },
              "providers": {
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "project_id",
              "limits"
            ],
            "type": "object"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "body",
          "idempotency_key"
        ],
        "type": "object"
      },
      "name": "swarms_run_launch",
      "operationId": "createRun",
      "scope": "swarms:run"
    },
    {
      "description": "One run snapshot.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_get",
      "operationId": "getRun",
      "scope": "swarms:read"
    },
    {
      "description": "Ordered run events, one cursor page at a time.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_events",
      "operationId": "listRunEvents",
      "scope": "swarms:read"
    },
    {
      "description": "Cancel a run.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "idempotency_key"
        ],
        "type": "object"
      },
      "name": "swarms_run_cancel",
      "operationId": "cancelRun",
      "scope": "swarms:control"
    },
    {
      "description": "A run's outputs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_outputs",
      "operationId": "listRunOutputs",
      "scope": "swarms:read"
    },
    {
      "description": "One output record.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "output_id": {
            "examples": [
              "out_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^out_[A-Za-z0-9_-]{22}$",
            "type": "string"
          },
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "output_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_output_get",
      "operationId": "getRunOutput",
      "scope": "swarms:read"
    },
    {
      "description": "Create a Swarms project (launch-enabled).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "properties": {
              "code_validation": {
                "additionalProperties": true,
                "type": "object"
              },
              "name": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "objective": {
                "maxLength": 8192,
                "type": "string"
              },
              "template": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "body",
          "idempotency_key"
        ],
        "type": "object"
      },
      "name": "swarms_project_create",
      "operationId": "createProject",
      "scope": "swarms:write"
    },
    {
      "description": "List projects, newest first.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "swarms_projects_list",
      "operationId": "listProjects",
      "scope": "swarms:read"
    },
    {
      "description": "One project of the caller's organization.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "examples": [
              "proj_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^proj_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "project_id"
        ],
        "type": "object"
      },
      "name": "swarms_project_get",
      "operationId": "getProject",
      "scope": "swarms:read"
    },
    {
      "description": "The launchable program families (GA set, swarms.general@1).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "swarms_families_list",
      "operationId": "listFamilies",
      "scope": "swarms:read"
    },
    {
      "description": "Wallet position of the caller's org in integer microcents (1 USD = 10^8).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "account_billing_balance",
      "operationId": "getBalance",
      "scope": "account:billing:read"
    }
  ]
