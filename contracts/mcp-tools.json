{
  "tools": [
    {
      "description": "The caller's org, principal and limits.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "account_get",
      "operationId": "getAccount",
      "scope": "account:read"
    },
    {
      "description": "The caller's runs, newest first.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "created_after": {
            "format": "date-time",
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "swarms_runs_list",
      "operationId": "listRuns",
      "scope": "swarms:read"
    },
    {
      "description": "Launch a run.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "additionalProperties": false,
            "properties": {
              "guidance": {
                "description": "What the run must address. The planner covers or declines each item. A metric on an item binds every objective derived from it, and the planner cannot change or drop it. Not accepted with method.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "acceptance": {
                      "maxLength": 8192,
                      "type": [
                        "string",
                        "null"
                      ],
                      "x-synth-max-bytes": 8192,
                      "x-synth-no-nul": true
                    },
                    "evidence": {
                      "maxLength": 8192,
                      "type": [
                        "string",
                        "null"
                      ],
                      "x-synth-max-bytes": 8192,
                      "x-synth-no-nul": true
                    },
                    "id": {
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "question",
                        "outcome",
                        "any"
                      ],
                      "type": "string"
                    },
                    "metric": {
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "description": "A target the platform measures from scored rollouts.",
                          "properties": {
                            "direction": {
                              "enum": [
                                "maximize",
                                "minimize"
                              ],
                              "type": "string"
                            },
                            "name": {
                              "maxLength": 128,
                              "minLength": 1,
                              "type": "string",
                              "x-synth-max-bytes": 128,
                              "x-synth-message-text": true
                            },
                            "source": {
                              "enum": [
                                "rollout_score"
                              ],
                              "type": "string"
                            },
                            "target": {
                              "description": "A number, or a decimal string to keep digits a float cannot hold.",
                              "pattern": "^-?[0-9]{1,18}(\\.[0-9]{1,18})?$",
                              "type": [
                                "number",
                                "string"
                              ]
                            }
                          },
                          "required": [
                            "name",
                            "direction",
                            "target",
                            "source"
                          ],
                          "type": "object"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "priority": {
                      "enum": [
                        "must",
                        "should",
                        "nice"
                      ],
                      "type": "string"
                    },
                    "text": {
                      "maxLength": 8192,
                      "minLength": 1,
                      "type": "string",
                      "x-synth-max-bytes": 8192,
                      "x-synth-message-text": true
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "text",
                    "priority"
                  ],
                  "type": "object"
                },
                "maxItems": 32,
                "type": [
                  "array",
                  "null"
                ]
              },
              "inputs": {
                "properties": {
                  "files": {
                    "items": {
                      "properties": {
                        "digest_sha256": {
                          "pattern": "^[0-9a-f]{64}$",
                          "type": "string"
                        },
                        "file_id": {
                          "type": "string"
                        },
                        "revision_id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "file_id",
                        "revision_id",
                        "digest_sha256"
                      ],
                      "type": "object"
                    },
                    "maxItems": 32,
                    "type": "array"
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "labels": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "limits": {
                "additionalProperties": false,
                "description": "An explicit positive USD budget is required. Task and parallelism limits are service-owned.",
                "properties": {
                  "maximum_charge": {
                    "additionalProperties": false,
                    "properties": {
                      "amount": {
                        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$",
                        "type": "string",
                        "x-synth-budget": true
                      },
                      "currency": {
                        "const": "USD",
                        "type": "string"
                      }
                    },
                    "required": [
                      "amount",
                      "currency"
                    ],
                    "type": "object"
                  },
                  "wall_time_seconds": {
                    "maximum": 86400,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "maximum_charge"
                ],
                "type": "object"
              },
              "message": {
                "maxLength": 8192,
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ],
                "x-synth-max-bytes": 8192,
                "x-synth-message-text": true
              },
              "method": {
                "additionalProperties": false,
                "description": "Runs a named method on a published task instead of a general run. Not accepted with program. Refused with 422 research_task_required when task is missing, 422 research_task_invalid when it is malformed, 404 research_task_not_found when no such task is published for this organization, 422 research_method_unknown for an unknown release, 422 research_method_unseeded when the task has no approval for this release, 422 research_method_revoked when that approval is revoked, and 409 research_method_unavailable when the release is not being served.",
                "properties": {
                  "overrides": {
                    "description": "Values for the release's published parameters.",
                    "type": "object"
                  },
                  "release": {
                    "enum": [
                      "research.fork_flush@1",
                      "research.forgetting@1"
                    ],
                    "type": "string"
                  },
                  "task": {
                    "description": "The published task this method runs on.",
                    "examples": [
                      "craftax-classic-enginebench-policy-v1"
                    ],
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
                    "type": "string"
                  }
                },
                "required": [
                  "release",
                  "task"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "profile_overrides": {
                "additionalProperties": false,
                "properties": {
                  "launch": {
                    "additionalProperties": false,
                    "properties": {
                      "canonical_model": {
                        "type": "string"
                      },
                      "effort": {
                        "enum": [
                          "low",
                          "medium",
                          "high",
                          "xhigh"
                        ],
                        "type": "string"
                      },
                      "preset": {
                        "enum": [
                          "hosted.openrouter_zdr_us",
                          "hosted.openai_direct",
                          "test.codex_pool"
                        ],
                        "type": "string"
                      },
                      "upstream_model": {
                        "enum": [
                          "gpt-6-luna",
                          "openai/gpt-6-luna"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [],
                    "type": "object"
                  },
                  "roles": {
                    "additionalProperties": {
                      "additionalProperties": false,
                      "properties": {
                        "canonical_model": {
                          "type": "string"
                        },
                        "effort": {
                          "enum": [
                            "low",
                            "medium",
                            "high",
                            "xhigh"
                          ],
                          "type": "string"
                        },
                        "preset": {
                          "enum": [
                            "hosted.openrouter_zdr_us",
                            "hosted.openai_direct",
                            "test.codex_pool"
                          ],
                          "type": "string"
                        },
                        "upstream_model": {
                          "enum": [
                            "gpt-6-luna",
                            "openai/gpt-6-luna"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [],
                      "type": "object"
                    },
                    "type": "object"
                  }
                },
                "required": [],
                "type": "object"
              },
              "program": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "type": "object"
              },
              "resources": {
                "items": {
                  "additionalProperties": false,
                  "oneOf": [
                    {
                      "properties": {
                        "limits": {
                          "propertyNames": {
                            "enum": [
                              "spend_micros",
                              "rollouts"
                            ]
                          },
                          "required": [
                            "spend_micros",
                            "rollouts"
                          ]
                        },
                        "plugin": {
                          "const": "pool"
                        },
                        "selection": {
                          "additionalProperties": false,
                          "properties": {
                            "pool_ids": {
                              "items": {
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                                "type": "string"
                              },
                              "maxItems": 8,
                              "minItems": 1,
                              "type": "array",
                              "uniqueItems": true
                            }
                          }
                        }
                      }
                    }
                  ],
                  "properties": {
                    "limits": {
                      "additionalProperties": {
                        "maximum": 9223372036854775807,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "maxProperties": 2,
                      "minProperties": 1,
                      "propertyNames": {
                        "enum": [
                          "spend_micros",
                          "rollouts",
                          "calls"
                        ]
                      },
                      "type": "object"
                    },
                    "plugin": {
                      "enum": [
                        "pool"
                      ],
                      "type": "string"
                    },
                    "role_limits": {
                      "additionalProperties": {
                        "additionalProperties": {
                          "maximum": 9223372036854775807,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "maxProperties": 2,
                        "minProperties": 1,
                        "propertyNames": {
                          "enum": [
                            "spend_micros",
                            "rollouts",
                            "calls"
                          ]
                        },
                        "type": "object"
                      },
                      "maxProperties": 4,
                      "propertyNames": {
                        "enum": [
                          "planner",
                          "worker",
                          "reviewer",
                          "run_assessor"
                        ]
                      },
                      "type": "object"
                    },
                    "roles": {
                      "items": {
                        "enum": [
                          "planner",
                          "worker",
                          "reviewer",
                          "run_assessor"
                        ],
                        "type": "string"
                      },
                      "maxItems": 4,
                      "minItems": 1,
                      "type": "array",
                      "uniqueItems": true
                    },
                    "selection": {
                      "type": "object"
                    },
                    "version": {
                      "const": 1,
                      "default": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "plugin",
                    "roles",
                    "limits",
                    "selection"
                  ],
                  "type": "object"
                },
                "maxItems": 8,
                "type": "array"
              },
              "routing": {
                "additionalProperties": false,
                "description": "Unordered hard restrictions across every managed inference actor. Provider restrictions include intermediaries and serving hosts. Omission leaves assignment to Synth.",
                "properties": {
                  "models": {
                    "oneOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "only": {
                            "items": {
                              "maxLength": 128,
                              "minLength": 1,
                              "type": "string"
                            },
                            "maxItems": 64,
                            "minItems": 1,
                            "type": "array",
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "only"
                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "exclude": {
                            "items": {
                              "maxLength": 128,
                              "minLength": 1,
                              "type": "string"
                            },
                            "maxItems": 64,
                            "type": "array",
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "exclude"
                        ],
                        "type": "object"
                      }
                    ]
                  },
                  "providers": {
                    "oneOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "only": {
                            "items": {
                              "maxLength": 128,
                              "minLength": 1,
                              "type": "string"
                            },
                            "maxItems": 64,
                            "minItems": 1,
                            "type": "array",
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "only"
                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "exclude": {
                            "items": {
                              "maxLength": 128,
                              "minLength": 1,
                              "type": "string"
                            },
                            "maxItems": 64,
                            "type": "array",
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "exclude"
                        ],
                        "type": "object"
                      }
                    ]
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "limits"
            ],
            "type": "object"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "body",
          "idempotency_key"
        ],
        "type": "object"
      },
      "name": "swarms_run_launch",
      "operationId": "createRun",
      "scope": "swarms:run"
    },
    {
      "description": "One run snapshot.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_get",
      "operationId": "getRun",
      "scope": "swarms:read"
    },
    {
      "description": "Ordered run events, one cursor page at a time.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_events",
      "operationId": "listRunEvents",
      "scope": "swarms:read"
    },
    {
      "description": "Cancel a run.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "idempotency_key"
        ],
        "type": "object"
      },
      "name": "swarms_run_cancel",
      "operationId": "cancelRun",
      "scope": "swarms:control"
    },
    {
      "description": "The sandboxes a run used, and whether they are gone.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_sandboxes",
      "operationId": "getRunSandboxes",
      "scope": "swarms:read"
    },
    {
      "description": "End-of-run charge, tokens, reward and timings.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_report",
      "operationId": "getRunReport",
      "scope": "swarms:read"
    },
    {
      "description": "A run's outputs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_outputs",
      "operationId": "listRunOutputs",
      "scope": "swarms:read"
    },
    {
      "description": "One output record.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "output_id": {
            "examples": [
              "out_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^out_[A-Za-z0-9_-]{22}$",
            "type": "string"
          },
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "output_id"
        ],
        "type": "object"
      },
      "name": "swarms_run_output_get",
      "operationId": "getRunOutput",
      "scope": "swarms:read"
    },
    {
      "description": "The launchable program families (GA set, swarms.general@1).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "swarms_families_list",
      "operationId": "listFamilies",
      "scope": "swarms:read"
    },
    {
      "description": "Wallet position of the caller's org in integer microcents (1 USD = 10^8).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "account_billing_balance",
      "operationId": "getBalance",
      "scope": "account:billing:read"
    },
    {
      "description": "Upload a text, Markdown or JSON file (up to 32 KiB inline).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "maxLength": 32768,
                "type": "string"
              },
              "media_type": {
                "enum": [
                  "text/plain",
                  "text/markdown",
                  "application/json"
                ],
                "type": "string"
              },
              "name": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "media_type",
              "content"
            ],
            "type": "object"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "body",
          "idempotency_key"
        ],
        "type": "object"
      },
      "name": "swarms_upload_file",
      "operationId": "uploadFile",
      "scope": "swarms:write"
    },
    {
      "description": "Replace run labels with a revision check.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "additionalProperties": false,
            "properties": {
              "expected_revision": {
                "minimum": 1,
                "type": "integer"
              },
              "labels": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              }
            },
            "required": [
              "labels",
              "expected_revision"
            ],
            "type": "object"
          },
          "run_id": {
            "examples": [
              "run_AAAAAAAAAAAAAAAAAAAAAA"
            ],
            "pattern": "^run_[A-Za-z0-9_-]{22}$",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "body"
        ],
        "type": "object"
      },
      "name": "swarms_run_labels_update",
      "operationId": "updateRunLabels",
      "scope": "swarms:write"
    }
  ]
}
