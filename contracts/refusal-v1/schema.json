{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synth.refusal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "service",
    "stage",
    "status",
    "retryable",
    "in_doubt",
    "operation_id",
    "request_id",
    "upstream",
    "detail"
  ],
  "properties": {
    "schema_version": {
      "const": "synth.refusal.v1"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,127}$"
    },
    "status": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        {
          "type": "null"
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "in_doubt": {
      "type": "boolean"
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "upstream": {
      "anyOf": [
        {
          "$ref": "#"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    }
  }
}
