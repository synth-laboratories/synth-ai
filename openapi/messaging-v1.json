{
  "components": {
    "schemas": {
      "CreateGrantRequest": {
        "additionalProperties": false,
        "properties": {
          "enrollment_id": {
            "format": "uuid",
            "title": "Enrollment Id",
            "type": "string"
          },
          "history_after_seq": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "History After Seq"
          },
          "operations": {
            "items": {
              "enum": [
                "read",
                "publish"
              ],
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 1,
            "title": "Operations",
            "type": "array"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          },
          "ttl_seconds": {
            "maximum": 2592000,
            "minimum": 60,
            "title": "Ttl Seconds",
            "type": "integer"
          }
        },
        "required": [
          "thread_id",
          "enrollment_id",
          "operations",
          "ttl_seconds"
        ],
        "title": "CreateGrantRequest",
        "type": "object"
      },
      "CreateThreadRequest": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "idempotency_key"
        ],
        "title": "CreateThreadRequest",
        "type": "object"
      },
      "CredentialRequest": {
        "additionalProperties": false,
        "properties": {
          "enrollment_id": {
            "format": "uuid",
            "title": "Enrollment Id",
            "type": "string"
          },
          "incarnation": {
            "minimum": 1,
            "title": "Incarnation",
            "type": "integer"
          },
          "ttl_seconds": {
            "default": 300,
            "maximum": 300,
            "minimum": 60,
            "title": "Ttl Seconds",
            "type": "integer"
          }
        },
        "required": [
          "enrollment_id",
          "incarnation"
        ],
        "title": "CredentialRequest",
        "type": "object"
      },
      "EmptyRequest": {
        "additionalProperties": false,
        "properties": {},
        "title": "EmptyRequest",
        "type": "object"
      },
      "EnrollRequest": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "title": "Device Id",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "session_id": {
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "session_id"
        ],
        "title": "EnrollRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PublishMessageRequest": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 65536,
            "title": "Body",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "kind": {
            "enum": [
              "ask",
              "answer",
              "steer",
              "notice",
              "actor_runtime",
              "blocker",
              "handoff_ping"
            ],
            "title": "Kind",
            "type": "string"
          },
          "parent_message_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Message Id"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "kind",
          "body",
          "idempotency_key"
        ],
        "title": "PublishMessageRequest",
        "type": "object"
      },
      "RenewRequest": {
        "additionalProperties": false,
        "properties": {
          "ttl_seconds": {
            "maximum": 2592000,
            "minimum": 60,
            "title": "Ttl Seconds",
            "type": "integer"
          }
        },
        "required": [
          "ttl_seconds"
        ],
        "title": "RenewRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
